{
  "name": "@feedbackjar/react-native-sdk",
  "version": "0.7.1",
  "description": "React Native SDK for FeedbackJar — collect user feedback from iOS and Android apps",
  "homepage": "https://feedbackjar.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/feedbackjar/react-native-sdk.git"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "sync-version": "node scripts/sync-version.mjs",
    "version": "node scripts/sync-version.mjs && git add src/version.ts",
    "prepublishOnly": "node scripts/check-version.mjs"
  },
  "files": [
    "src",
    "android",
    "ios",
    "react-native.config.js",
    "FeedbackJarReactNativeSdk.podspec"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=1.0.0",
    "react": ">=17.0.0",
    "react-native": ">=0.70.0"
  },
  "peerDependenciesMeta": {
    "@react-native-async-storage/async-storage": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-native": "^0.73.0",
    "react": "19.1.0",
    "typescript": "^5.8.2"
  },
  "keywords": [
    "feedbackjar",
    "feedback",
    "react-native",
    "ios",
    "android",
    "sdk"
  ]
